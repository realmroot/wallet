{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-wallet",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "routes": [
    {
      "pattern": "wallet.realmroot.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/healthz", "/readyz", "/openapi.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-wallet",
      "database_id": "2eaea6ba-b43a-484d-9f5c-5a29bace5849",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://wallet.realmroot.dev",
    "OIDC_ISSUER": "https://id.realmroot.dev/api/auth",
    "OIDC_CLIENT_ID": "client_87c987abcddf4bb1b283794d626a0f43",
    "OIDC_AUDIENCE": "https://wallet.realmroot.dev/api",
    "WALLET_NETWORK": "eip155:84532",
    "WALLET_RPC_URL": "https://sepolia.base.org",
    "SIGNER_MODE": "cdp"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
