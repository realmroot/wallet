{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-wallet",
  "main": "server/worker.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/healthz", "/readyz", "/openapi.json"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agent-wallet",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:6230",
    "OIDC_ISSUER": "http://localhost:5173/api/auth",
    "OIDC_CLIENT_ID": "agent-wallet-web",
    "OIDC_AUDIENCE": "http://localhost:6230/api",
    "WALLET_NETWORK": "eip155:84532",
    "WALLET_RPC_URL": "https://sepolia.base.org",
    "SIGNER_MODE": "cdp"
  },
  "triggers": {
    "crons": ["*/2 * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
